* text=auto

# Scripts : fins de ligne Unix obligatoires
run.sh text eol=lf
scripts/*.py text eol=lf
scripts/tests/*.py text eol=lf
*.sh text eol=lf

# Le hash du commit final est substitué par git archive.
LIEN_GIT.txt export-subst

# La fiche de validation est un document séparé (Google Classroom).
FICHE_VALIDATION.md export-ignore

# Ces dossiers ne doivent pas entrer dans l'archive de remise.
data/raw export-ignore
data/processed export-ignore
tmp export-ignore
.venv export-ignore
__pycache__ export-ignore
.pytest_cache export-ignore
